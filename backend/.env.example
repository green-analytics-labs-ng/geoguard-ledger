# GeoGuard Ledger — Backend Environment Variables
# Copy this file to .env and adjust values for your environment.
#
# All settings correspond to fields in app/config.py (pydantic-settings).
# Unset values fall back to the defaults defined in config.py.

# Database
# PostgreSQL connection string (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://geoguard:geoguard_dev@localhost:5432/geoguard_ledger

# Soroban / Stellar
# RPC endpoint for the Stellar Soroban network.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Network passphrase for transaction signing.
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Deployed GeoGuardLedger smart contract ID (set after contract deployment).
CONTRACT_ID=
# Timeout (seconds) for the Soroban RPC probe used by GET /api/v1/health.
SOROBAN_RPC_HEALTH_TIMEOUT_SECONDS=3.0

# ---------------------------------------------------------------------------
# Test-only signing key
# ---------------------------------------------------------------------------
# Used exclusively by the opt-in e2e scripts in backend/tests/ (e.g.
# e2e_submission_flow.py). Must be a funded Testnet key. Leave this empty in
# shared environments, and never commit a real secret - if one ever lands in
# git history it must be rotated on-chain.
DEPLOYER_SECRET=

# ---------------------------------------------------------------------------
# TTL renewal
# ---------------------------------------------------------------------------
# On-chain anchors are Persistent ledger entries that Soroban archives once
# their TTL runs out, which would make whatever they cover unverifiable: every
# dataset in a batch for a batch root, one dataset for a standalone record. The
# job below renews both before that happens. It is the only component that
# spends fees, so it stays off until enabled here.

# Master switch for the renewal job (see app/jobs/renew_ttl.py).
TTL_RENEWAL_ENABLED=false
# StrKey secret (S...) of the operational "rent payer" account. Renewal is a
# state-changing call, so it must be signed by a funded account the backend
# holds. It can only push an expiry out - it cannot alter a record. Never commit
# a real secret; rotate it on-chain if one ever lands in git history.
TTL_RENEWAL_SIGNER_SECRET=
# Ledgers a renewal extends an entry to (~180 days at 5s/ledger). Mirrors
# ROOT_TTL_EXTEND_TO and RECORD_TTL_EXTEND_TO in
# contracts/geoguard-ledger/src/storage.rs - change all three together or the
# job will renew against a deadline the contract will not honour.
TTL_RENEWAL_EXTEND_TO_LEDGERS=3110400
# Renew once an entry has less than this much life left. Must stay below the
# contract's renewal margin (~174 days) or the call becomes a silent no-op.
TTL_RENEWAL_WINDOW_DAYS=30
# Most entries a single run will renew across both kinds (roots and records),
# bounding fee spend per run.
TTL_RENEWAL_MAX_ENTRIES_PER_RUN=20

# API Server
API_HOST=0.0.0.0
API_PORT=8000
# JSON array of allowed CORS origins.
API_CORS_ORIGINS=["http://localhost:5173"]
# Maximum accepted upload size, in bytes. Enforced server-side before the
# request body is read; keep in step with the frontend limit (50 MB).
MAX_UPLOAD_SIZE_BYTES=52428800

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Comma-separated keys accepted in the X-API-Key header on the write endpoints
# (uploads and anchoring). Empty disables authentication, which is the
# development default so a local checkout runs without setup - deployments must
# set at least one key. Verification (/verify) and health stay public on
# purpose: permissionless verification is a feature. Never commit real keys.
API_KEYS=

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
# The upload and verification endpoints parse and hash a file (and verification
# also calls Soroban RPC), so unauthenticated callers are counted per IP over a
# sliding window. Set RATE_LIMIT_ENABLED=false to switch the limiter off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# AI Model
# Version tag for the anomaly detection model.
AI_MODEL_VERSION=isoforest_v1
# Anomaly score threshold (0.0–1.0) for flagging datasets.
AI_ANOMALY_THRESHOLD=0.20
# Enable domain-informed geochemical plausibility checks alongside the
# statistical model (see docs/ai_model.md).
GEOCHEMICAL_VALIDATION_ENABLED=true

# Logging
# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
